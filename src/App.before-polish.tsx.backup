              {product.description}
            </p>

            {isComingSoon && (
              <div className="mt-4 h-1 overflow-hidden rounded-full bg-blue-100">
                <div className="loading-product-bar h-full rounded-full bg-blue-500" />
              </div>
            )}
          </article>
        )
      })}
    </div>
  )
}

